# Copiar a .env (local) o pegar como "Environment" en Dokploy.
# NUNCA commitear el .env real con secretos.

# ---- Postgres ----
POSTGRES_DB=hysvision
POSTGRES_USER=hysvision
POSTGRES_PASSWORD=change-me-strong-random

# ---- MinIO ----
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-strong-random

# ---- Backend / auth ----
JWT_SECRET=change-me-32-chars-minimum-random
BOOTSTRAP_ADMIN_EMAIL=admin@tudominio.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-random

# Orígenes permitidos para el frontend (CORS). Formato JSON, sin espacios extra.
# Debe incluir el dominio público del frontend servido por Dokploy.
CORS_ORIGINS=["https://app.tudominio.com"]

# ---- Frontend (build-time) ----
# URL pública del backend vista desde el navegador del usuario, con /api/v1.
VITE_API_BASE_URL=https://api.tudominio.com/api/v1

# ---- Puertos solo para uso LOCAL (compose.yaml). En Dokploy (compose.dokploy.yaml)
# no se usan: la exposición pública se configura en la pestaña Domains. ----
BACKEND_PORT=8160
FRONTEND_PORT=5200
