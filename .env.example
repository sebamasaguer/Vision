# Copiar a .env (local) o pegar como "Environment" en Dokploy.
# NUNCA commitear el .env real con secretos.

# ---- Postgres (base REMOTA, no corre en este compose) ----
# String de conexion completo a tu Postgres de produccion, con el driver
# psycopg (formato que usa SQLAlchemy en el backend). Ejemplos:
#   sin SSL:  postgresql+psycopg://usuario:password@host:5432/nombre_db
#   con SSL:  postgresql+psycopg://usuario:password@host:5432/nombre_db?sslmode=require
# La mayoria de proveedores gestionados (RDS, Supabase, Neon, DO Managed DB)
# piden sslmode=require u obligan TLS. El servidor de Dokploy necesita poder
# alcanzar host:puerto (firewall/allowlist de IP del lado del proveedor).
DATABASE_URL=postgresql+psycopg://usuario:password@tu-host-remoto:5432/hysvision?sslmode=require

# ---- MinIO ----
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-strong-random

# ---- Backend / auth ----
JWT_SECRET=change-me-32-chars-minimum-random
BOOTSTRAP_ADMIN_EMAIL=admin@tudominio.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-random

# Orígenes permitidos para el frontend (CORS). Formato JSON, sin espacios extra.
# Debe incluir el dominio público del frontend servido por Dokploy.
CORS_ORIGINS=["https://app.tudominio.com"]

# ---- Frontend (build-time) ----
# URL pública del backend vista desde el navegador del usuario, con /api/v1.
VITE_API_BASE_URL=https://api.tudominio.com/api/v1

# ---- Puertos solo para uso LOCAL (compose.yaml). En Dokploy (compose.dokploy.yaml)
# no se usan: la exposición pública se configura en la pestaña Domains. ----
BACKEND_PORT=8160
FRONTEND_PORT=5200

# ---- Landing (build-time, EmailJS para el formulario de demo) ----
# Sin configurar todavia (pendiente: crear cuenta en https://www.emailjs.com/).
# OJO: con estos valores vacios, el formulario "Solicitar Demo" de la landing
# NO falla visiblemente -- el modal simula un envio exitoso y muestra el
# mensaje de agradecimiento igual, sin mandar nada realmente (ver
# landing/src/components/DemoModal.jsx). O sea que un visitante real puede
# creer que se registro para una demo sin que el lead llegue a ningun lado.
# Cargar valores reales aca + hacer un rebuild del servicio frontend (se
# hornea en build, igual que VITE_API_BASE_URL) antes de que la landing
# reciba trafico real si esto importa.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
